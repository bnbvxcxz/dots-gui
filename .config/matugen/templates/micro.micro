color-link default "{{ colors.on_surface.default.hex }}"
color-link comment "italic {{ colors.outline.default.hex }}"
color-link selection "{{ colors.on_primary_container.default.hex }},{{ colors.primary_container.default.hex }}"
color-link hlsearch "{{ colors.on_secondary_container.default.hex }},{{ colors.secondary_container.default.hex }}"

# Identifiers & variables
color-link identifier "bold {{ colors.on_surface.default.hex }}"
color-link identifier.class "bold {{ colors.primary.default.hex }}"
color-link identifier.var "{{ colors.on_surface_variant.default.hex }}"

# Constants, numbers & strings
color-link constant "{{ colors.tertiary.default.hex }}"
color-link constant.number "bold {{ colors.tertiary.default.hex }}"
color-link constant.string "{{ colors.secondary.default.hex }}"

# Symbols & punctuation
color-link symbol "bold {{ colors.secondary.default.hex }}"
color-link symbol.brackets "{{ colors.outline.default.hex }}"
color-link symbol.tag "bold {{ colors.primary.default.hex }}"

# Types & Keywords
color-link type "bold {{ colors.tertiary.default.hex }}"
color-link type.keyword "bold {{ colors.primary.default.hex }}"

# Language statements & preprocessor
color-link special "{{ colors.tertiary.default.hex }}"
color-link statement "bold {{ colors.primary.default.hex }}"
color-link preproc "bold {{ colors.secondary.default.hex }}"

# Meta & state
color-link underlined "underline {{ colors.secondary.default.hex }}"
color-link error "bold {{ colors.error.default.hex }}"
color-link todo "bold {{ colors.tertiary.default.hex }}"

# Git diffs
color-link diff-added "{{ colors.secondary.default.hex }}"
color-link diff-modified "{{ colors.tertiary.default.hex }}"
color-link diff-deleted "{{ colors.error.default.hex }}"

# Gutters & margins
color-link gutter-error "{{ colors.error.default.hex }}"
color-link gutter-warning "{{ colors.tertiary.default.hex }}"
color-link line-number "{{ colors.on_surface_variant.default.hex }}"
color-link current-line-number "bold {{ colors.primary.default.hex }}"
color-link cursor-line "{{ colors.surface_container_low.default.hex }}"
color-link color-column "{{ colors.surface_container.default.hex }}"
color-link indent-char "{{ colors.surface_container_highest.default.hex }}"

# Editor UI chrome
color-link scrollbar "{{ colors.surface_container_highest.default.hex }}"
color-link statusline "{{ colors.on_surface.default.hex }},{{ colors.surface_container.default.hex }}"
color-link tabbar "{{ colors.on_surface_variant.default.hex }},{{ colors.surface_container_lowest.default.hex }}"
color-link type.extended "default"
