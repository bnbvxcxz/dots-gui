layout {
	background-color "transparent"

    focus-ring {
        active-color "#9ecafc"
        inactive-color "#8c9199"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#9ecafc"
        inactive-color "#8c9199"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#9ecafc"
        inactive-color "#8c9199"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#9ecafc80"
    }
}

overview {
	backdrop-color "#101418"
}

recent-windows {
    highlight {
        active-color "#9ecafc"
        urgent-color "#ffb4ab"
    }
}

window-rule {
    match is-window-cast-target=true

    border {
        active-color "#ffb4ab"
        inactive-color "#ffb4ab"
    }
}
