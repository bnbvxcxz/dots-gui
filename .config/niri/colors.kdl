layout {
	background-color "transparent"

    focus-ring {
        active-color "#8ad0ee"
        inactive-color "#8a9296"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#8ad0ee"
        inactive-color "#8a9296"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#8ad0ee"
        inactive-color "#8a9296"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#8ad0ee80"
    }
}

overview {
	backdrop-color "#0f1417"
}

recent-windows {
    highlight {
        active-color "#8ad0ee"
        urgent-color "#ffb4ab"
    }
}

window-rule {
    match is-window-cast-target=true

    border {
        active-color "#ffb4ab"
        inactive-color "#ffb4ab"
    }
}
