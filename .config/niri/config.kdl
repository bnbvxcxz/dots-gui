input {
    keyboard {
        xkb {
            layout "us"
        }
    }

    touchpad {
        tap
        dwt
    }

    mouse {
        accel-profile "flat"
    }

    workspace-auto-back-and-forth
}

cursor {
    hide-when-typing
}

output "DP-1" {
    position x=0 y=0
    scale 1
}

output "HDMI-A-1" {
    mode "1920x1080@60"
    scale 1
}

include "./host.kdl"

layout {
    gaps 0
    center-focused-column "on-overflow"

    preset-column-widths {
        proportion 1.0
        proportion 0.5
    }

    preset-window-heights {
        proportion 1.0
        proportion 0.5
    }

    default-column-width { proportion 0.5; }

    background-color "transparent"

    focus-ring {
        off
    }

    border {
        width 1
    }

    shadow {
        off
    }

    tab-indicator {
        width 4
        gap 4
        position "left"
        place-within-column
    }
}

layer-rule {
    match namespace="^wallpaper$"
    place-within-backdrop true
}

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/%Y-%m-%d-%H%M%S.png"

environment {
    MOZ_ENABLE_WAYLAND "1"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    QT_QPA_PLATFORM "wayland;xcb"
    QT_QPA_PLATFORMTHEME "qt6ct"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    QT_AUTO_SCREEN_SCALE_FACTOR "1"
}

animations {
    slowdown 0.45

    horizontal-view-movement {
        spring damping-ratio=0.92 stiffness=900 epsilon=0.0001
    }

    workspace-switch {
        spring damping-ratio=0.92 stiffness=900 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=0.92 stiffness=850 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=0.92 stiffness=850 epsilon=0.0001
    }

    window-open {
        duration-ms 120
        curve "ease-out-cubic"
    }

    window-close {
        duration-ms 100
        curve "ease-out-quad"
    }

    overview-open-close {
        spring damping-ratio=0.95 stiffness=1100 epsilon=0.0001
    }
}

spawn-at-startup "waypaper" "--restore"
spawn-at-startup "quickshell"
spawn-at-startup "wl-paste" "--type" "text" "--watch" "cliphist" "store"
spawn-at-startup "wl-paste" "--type" "image" "--watch" "cliphist" "store"
spawn-at-startup "hypridle"
spawn-at-startup "sway-audio-idle-inhibit"

// Window Rules

window-rule {
    match app-id=r#"^kitty$"#
    draw-border-with-background false
}

window-rule {
    match app-id=r#"^waybar_update$"#
    open-floating true
    default-column-width { fixed 1000; }
    default-window-height { fixed 800; }
}

window-rule {
    match title=r#"^Picture-in-Picture$"#
    open-floating true
    default-floating-position x=32 y=32 relative-to="top-right"
}

window-rule {
    match app-id=r#"^steam$"#
    exclude title=r#"^Steam$"#
    open-floating true
}

window-rule {
    match app-id=r#"^musicbee\.exe$"#
    exclude title=r#"MusicBee"#
    open-floating true
}

window-rule {
    match app-id=r#"^(cs2|cstrike_linux64)$"#
    variable-refresh-rate true
}

window-rule {
    match app-id=r#"org\.pulseaudio\.pavucontrol"#
    open-floating true
    default-column-width { fixed 700; }
    default-window-height { fixed 600; }
}

window-rule {
    match app-id=r#"waypaper"#
    open-floating true
    default-column-width { fixed 900; }
    default-window-height { fixed 700; }
}

window-rule {
    match app-id=r#"^yazi-portal$"#
    open-floating true
    default-column-width { fixed 1100; }
    default-window-height { fixed 700; }
}

window-rule {
    match app-id=r#"^(org\.keepassxc\.KeePassXC|Bitwarden|1password)$"#
    block-out-from "screen-capture"
}

// Keybindings

binds {
    // System & Session
    Mod+Slash { show-hotkey-overlay; }
    Mod+Q { close-window; }
    Mod+Delete { close-window; }
    Mod+Shift+Q hotkey-overlay-title="Force Kill Focused Window" { spawn "sh" "-c" "kill -9 $(niri msg -j focused-window | jq .pid)"; }
    Mod+Backslash hotkey-overlay-title="Lock Screen" { spawn "sh" "-c" "pidof hyprlock || hyprlock"; }
    Mod+Shift+Backslash hotkey-overlay-title="Lock & Sleep Monitors" { spawn "sh" "-c" "pidof hyprlock || (hyprlock & sleep 1 && niri msg action power-off-monitors)"; }
    Mod+Shift+Escape { quit; }

    // Window State & Layout
    Mod+F { fullscreen-window; }
    Mod+M { maximize-window-to-edges; }
    Mod+T { toggle-window-floating; }
    Mod+Shift+T { switch-focus-between-floating-and-tiling; }
    Mod+Tab repeat=false { toggle-overview; }
    Mod+O repeat=false { toggle-overview; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+C { center-column; }
    Mod+Shift+C { center-window; }
    Mod+Ctrl+F { expand-column-to-available-width; }

    // Stacking & Grouping
    Mod+W { toggle-column-tabbed-display; }
    Mod+G { toggle-column-tabbed-display; }
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Minus        { consume-or-expel-window-left; }
    Mod+Equal        { consume-or-expel-window-right; }

    // Screen-Share Casting
    Mod+P       { set-dynamic-cast-window; }
    Mod+Shift+P { set-dynamic-cast-monitor; }
    Mod+Ctrl+P  { clear-dynamic-cast-target; }

    // Launchers & Utilities
    Mod+E { spawn "sh" "-c" "niri msg action focus-column-first && dolphin"; }
    Mod+Return { spawn "sh" "-c" "niri msg action focus-column-first && kitty"; }
    Mod+Ctrl+Return { spawn "sh" "-c" "niri msg action focus-column-first && fuzzel"; }
    Mod+B { spawn "sh" "-c" "niri msg action focus-column-first && waterfox"; }
    Mod+V hotkey-overlay-title="Clipboard History" { spawn "sh" "-c" "cliphist list | wofi --dmenu | cliphist decode | wl-copy"; }
    Mod+Ctrl+W { spawn "waypaper"; }
    Mod+N hotkey-overlay-title="Toggle Quickshell Drawer" { spawn "quickshell" "ipc" "call" "drawer" "toggle"; }

    // Screenshots
    Print { screenshot; }
    Shift+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }
    Mod+S { screenshot; }
    Mod+Shift+S { screenshot-screen; }
    Mod+Ctrl+S hotkey-overlay-title="Screenshot Clicked Window" {
        spawn "sh" "-c" "id=$(niri msg --json pick-window | jq -r .id) && [ -n \"$id\" ] && niri msg action screenshot-window --id \"$id\""
    }

    // Horizontal Column Focus & Move (Mod = Focus, Mod+Shift = Move)
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }

    // Vertical Window Focus & Move Inside Column (Mod = Focus, Mod+Shift = Move)
    Mod+U { focus-window-down; }
    Mod+I { focus-window-up; }
    Mod+Shift+U { move-window-down; }
    Mod+Shift+I { move-window-up; }

    // Jump Workspace Ends (Mod = Focus, Mod+Shift = Move)
    Mod+A    { focus-column-first; }
    Mod+D    { focus-column-last; }
    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Shift+A    { move-column-to-first; }
    Mod+Shift+D    { move-column-to-last; }
    Mod+Shift+Home { move-column-to-first; }
    Mod+Shift+End  { move-column-to-last; }

    // Workspace Navigation (Mod = Focus, Mod+Shift = Move)
    Mod+J    { focus-workspace-down; }
    Mod+K    { focus-workspace-up; }
    Mod+Down { focus-workspace-down; }
    Mod+Up   { focus-workspace-up; }
    Mod+Shift+J    { move-column-to-workspace-down; }
    Mod+Shift+K    { move-column-to-workspace-up; }
    Mod+Shift+Down { move-column-to-workspace-down; }
    Mod+Shift+Up   { move-column-to-workspace-up; }

    // Mouse Scroll
    Mod+WheelScrollDown       { focus-column-right; }
    Mod+WheelScrollUp         { focus-column-left; }
    Mod+Shift+WheelScrollDown { move-column-right; }
    Mod+Shift+WheelScrollUp   { move-column-left; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }

    // Workspaces 1-10 (Mod = Focus, Mod+Shift = Move)
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace 10; }

    // Monitors (Mod = Focus, Mod+Shift = Move)
    Mod+Comma { focus-monitor-left; }
    Mod+Period { focus-monitor-right; }
    Mod+Shift+Comma { move-column-to-monitor-left; }
    Mod+Shift+Period { move-column-to-monitor-right; }

    // Hardware & Media
    XF86AudioRaiseVolume allow-when-locked=true { spawn "quickshell" "ipc" "call" "hw" "volUp"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "quickshell" "ipc" "call" "hw" "volDown"; }
    XF86AudioMute allow-when-locked=true { spawn "quickshell" "ipc" "call" "hw" "volMute"; }
    XF86AudioMicMute allow-when-locked=true { spawn "quickshell" "ipc" "call" "hw" "micMute"; }
    XF86MonBrightnessDown { spawn "quickshell" "ipc" "call" "hw" "briDown"; }
    XF86MonBrightnessUp { spawn "quickshell" "ipc" "call" "hw" "briUp"; }
    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }
}

include "./colors.kdl"
